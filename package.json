{
  "name": "event-radar-web",
  "version": "1.0.0",
  "private": true,
  "description": "Event manager tool",
  "homepage": "",
  "license": "See LICENSE file",
  "author": {
    "name": "Chetan Patil"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "npm run prettier && npm run lint:js",
    "lint:commit": "commitlint --edit",
    "lint:commit:head": "commitlint --from=HEAD~1",
    "lint:fix": "npm run prettier:fix && npm run lint:js:fix",
    "lint:js": "eslint .",
    "lint:js:debug": "npm run lint:js -- --debug",
    "lint:js:fix": "eslint . --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "start": "vite --host",
    "test": "vitest",
    "test:ci": "vitest --coverage --bail 10 --retry 3 --silent",
    "test:ci:debug": "vitest --coverage --bail --debug --detectOpenHandles --runInBand --logHeapUsage",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headless": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "tsc:start": "tsc --noEmit --watch"
  },
  "lint-staged": {
    "./**/*.{js,ts,jsx,tsx,mdx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "./**/*.{json,md,yml,yaml,sh,xml,svg,html}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": ">=9.0.0"
    }
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/format": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.14",
    "playwright-msw": "^3.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.18.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "25.x",
    "npm": "11.x"
  }
}
